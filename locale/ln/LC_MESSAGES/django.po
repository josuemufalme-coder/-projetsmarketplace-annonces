#: templates/base.html:7
msgid ""
"Petites annonces à Kinshasa : immobilier, véhicules, téléphones, emploi et "
"plus."
msgstr ""
"Koteka mpe kosomba na Kinshasa : bandako, mituka, batelefone, misala mpe "
"makambo mosusu."

#: templates/base.html:20
msgid "Déconnexion"
msgstr "Kobima"

#: templates/base.html:23 templates/comptes/connexion.html:4
#: templates/comptes/connexion.html:8 templates/comptes/inscription.html:18
msgid "Connexion"
msgstr "Kokota"

#: templates/base.html:24 templates/comptes/connexion.html:18
#: templates/comptes/inscription.html:4 templates/comptes/inscription.html:8
msgid "Créer un compte"
msgstr "Fungola konti"

#: templates/base.html:47
msgid "Petites annonces à Kinshasa"
msgstr "Koteka mpe kosomba na Kinshasa"

#: templates/comptes/connexion.html:10
msgid "Adresse e-mail ou mot de passe incorrect."
msgstr "Adresse e-mail to mot de passe ezali malamu te."

#: templates/comptes/connexion.html:15
msgid "Se connecter"
msgstr "Kokota"

#: templates/comptes/connexion.html:18
msgid "Pas encore de compte ?"
msgstr "Ozali na konti te ?"

#: templates/comptes/inscription.html:10
msgid ""
"Gratuit et immédiat. Un compte est nécessaire pour publier une annonce ou "
"contacter un vendeur."
msgstr ""
"Ofele mpe mbala moko. Esengeli na konti mpo na kotia annonce to kobenga "
"motekisi."

#: templates/comptes/inscription.html:15
msgid "Créer mon compte"
msgstr "Fungola konti na ngai"

#: templates/comptes/inscription.html:18
msgid "Déjà un compte ?"
msgstr "Ozali na konti ?"

#: templates/comptes/profil.html:4 templates/comptes/profil.html:8
msgid "Mon profil"
msgstr "Profil na ngai"

#: templates/comptes/profil.html:13
msgid "Enregistrer"
msgstr "Bomba"

#: templates/core/home.html:4 templates/core/home.html:36
msgid "Bientôt disponible"
msgstr "Ekomonana kala mingi te"

#: templates/core/home.html:38
msgid ""
"La plateforme de petites annonces de Kinshasa : immobilier, véhicules, "
"téléphones, emploi, services et plus — gratuite pour tous."
msgstr ""
"Esika ya koteka mpe kosomba na Kinshasa : bandako, mituka, batelefone, "
"misala mpe makambo mosusu — ofele mpo na bato nyonso."
